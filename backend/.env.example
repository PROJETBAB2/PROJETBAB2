# --- Quand tu redéploieras ---
# Base : PostgreSQL + prisma/schema.prisma (provider postgresql) + migrations PG + par ex.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"
# Build API : npm run build:deploy   puis   npm run start:deploy
# Front : héberge dist/ (Vercel, Netlify, etc.) ; en dev le proxy Vite pointe sur localhost:4000.
# Sur un hébergeur front-only, ajoute des rewrites /api et /uploads vers l’URL publique du backend,
# ou définis VITE_PUBLIC_BASE_URL vers cette API.
